{
  "name": "react-native-nitro-sfsymbols",
  "version": "2.0.0",
  "description": "Render Apple SF Symbols natively in React Native via Nitro Modules. Type-safe, accessible, tree-shakable.",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./lib/typescript/src/index.d.ts",
      "source": "./src/index.tsx",
      "default": "./lib/module/index.js"
    },
    "./icons": {
      "types": "./lib/typescript/src/icons.d.ts",
      "source": "./src/icons.ts",
      "default": "./lib/module/icons.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "nitrogen",
    "nitro.json",
    "*.podspec",
    "react-native.config.js",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "yarn workspace react-native-nitro-sfsymbols-example",
    "test": "jest",
    "typecheck": "tsc",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build lib",
    "prepare": "bob build",
    "nitrogen": "nitrogen",
    "release": "release-it"
  },
  "keywords": [
    "react-native",
    "ios",
    "macos",
    "tvos",
    "visionos",
    "android",
    "sf-symbols",
    "icons",
    "nitro-modules"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mCodex/react-native-nitro-sfsymbols.git"
  },
  "author": "Mateus Andrade <mat.andrade@live.com> (https://github.com/mCodex)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mCodex/react-native-nitro-sfsymbols/issues"
  },
  "homepage": "https://github.com/mCodex/react-native-nitro-sfsymbols#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@commitlint/config-conventional": "^20.5.0",
    "@evilmartians/lefthook": "^2.1.6",
    "@react-native/babel-preset": "0.85.2",
    "@release-it/conventional-changelog": "^11.0.0",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.14",
    "babel-plugin-react-compiler": "^1.0.0",
    "commitlint": "^20.5.2",
    "del-cli": "^7.0.0",
    "jest": "^30.3.0",
    "nitrogen": "^0.35.5",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-builder-bob": "^0.41.0",
    "react-native-nitro-modules": "^0.35.5",
    "release-it": "^20.0.1",
    "ts-jest": "^29.4.9",
    "turbo": "^2.9.6",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-nitro-modules": ">=0.35.0"
  },
  "workspaces": [
    "example"
  ],
  "packageManager": "yarn@3.6.1",
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.test.json"
        }
      ]
    },
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "custom",
        {
          "script": "nitrogen",
          "clean": "nitrogen/"
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "create-react-native-library": {
    "languages": "kotlin-swift",
    "type": "nitro-view",
    "version": "0.54.7"
  }
}
